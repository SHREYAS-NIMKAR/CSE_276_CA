# Application port (must be 3000 in AI Studio preview)
PORT=3000

# Database URL: leave empty or sqlite:./data/governance.db for local dev;
# set postgres://app_user:password@localhost:5432/ai_governance for PostgreSQL
DATABASE_URL="sqlite:./data/governance.db"

# Cryptographic secret for session signing (set a strong random value in production)
SESSION_SECRET="change-me-to-a-long-random-secret-in-production"

# Session lifetime in seconds (default 8 hours)
SESSION_LIFETIME_SECONDS=28800

# Comma-separated allowed CORS origins (empty = same-origin only)
ALLOWED_ORIGINS="http://localhost:3000"

# Directory for uploaded evidence attachments
UPLOAD_DIR="./uploads"

# Set to false for a clean production deployment without demo users or demo projects
# SEED_DEMO_DATA=false
